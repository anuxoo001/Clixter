# Server environment variables
# Copy this file to server/.env for local development and fill in real values.

MONGO_URI=your_mongo_connection_string
JWT_SECRET=your_jwt_secret
PORT=5000
NODE_ENV=development

# Comma-separated list of allowed frontend origins
CLIENT_URLS=http://localhost:5173,https://clixter.vercel.app

# Cloudinary (for image uploads)
CLOUD_NAME=your_cloudinary_cloud_name
API_KEY=your_cloudinary_api_key
API_SECRET=your_cloudinary_api_secret
CLOUDINARY_URL=cloudinary://your_cloudinary_api_key:your_cloudinary_api_secret@your_cloudinary_cloud_name

# Client environment variables
# Copy this file to client/.env for local development.
VITE_API_URL=http://localhost:5000