# Root environment variables for Clixter deployments

# Server
MONGO_URI=your_mongo_connection_string
CLIENT_URLS=https://clixter.vercel.app,https://clixter-git-main-ananta-kumar-parida-s-projects.vercel.app,https://your-render-app.onrender.com
CLOUD_NAME=your_cloudinary_cloud_name
API_KEY=your_cloudinary_api_key
API_SECRET=your_cloudinary_api_secret
JWT_SECRET=your_jwt_secret
PORT=5000
NODE_ENV=production

# Client
VITE_API_URL=https://your-render-service.onrender.com
